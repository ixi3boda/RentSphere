# Copy to .env and fill in real values. .env is gitignored and never committed.
# docker compose reads this file automatically; Spring Boot imports it via
# spring.config.import in application.properties (for non-Docker `mvn spring-boot:run`).

# --- MySQL container credentials ---
MYSQL_DATABASE=RentSphereSchema
MYSQL_USER=change-me
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# --- Backend (non-Docker local run against localhost MySQL) ---
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/RentSphereSchema
SPRING_DATASOURCE_USERNAME=change-me
SPRING_DATASOURCE_PASSWORD=change-me

# --- Security ---
# HMAC-SHA256 signing key; must be at least 32 characters
JWT_SECRET=replace-with-a-random-256-bit-secret-value
JWT_EXPIRATION=86400000

# --- PayPal ---
PAYPAL_CLIENT_ID=change-me
PAYPAL_CLIENT_SECRET=change-me
PAYPAL_MODE=sandbox
